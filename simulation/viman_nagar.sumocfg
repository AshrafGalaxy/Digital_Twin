<?xml version="1.0" encoding="UTF-8"?>
<!--
  viman_nagar.sumocfg
  Master Eclipse SUMO configuration for Nagar Road Pilot Corridor.
-->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="net/viman_nagar.net.xml"/>
        <route-files value="routes/viman_nagar_baseline.rou.xml"/>
        <additional-files value="net/viman_nagar.tll.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1.0"/>
    </time>
    <processing>
        <time-to-teleport value="-1"/>
        <collision.action value="none"/>
    </processing>
    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
    </report>
</configuration>
