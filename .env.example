# ==========================================
# Digital Twin - Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL + PostGIS + TimescaleDB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=digital_twin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Message Broker (Eclipse Mosquitto MQTT)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_WS_PORT=9001
MQTT_USERNAME=twin_service
MQTT_PASSWORD=twin_secret_dev
MQTT_CLIENT_ID=digital_twin_backend

# Backend API Service
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Eclipse SUMO & TraCI
SUMO_HOME=
SUMO_BINARY=sumo
SUMO_GUI_BINARY=sumo-gui
SUMO_PORT=8813

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=corridor_traffic_energy
